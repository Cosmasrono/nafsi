# Public URL used for metadata, sitemap and share links
NEXT_PUBLIC_SITE_URL=https://www.nafsiafrica.org

# Form delivery by email (Resend). Without these, submissions are saved to .data/submissions.jsonl
RESEND_API_KEY=
NOTIFY_EMAIL=info@nafsiafrica.org
NOTIFY_FROM="Nafsi Africa Website <website@nafsiafrica.org>"

# Optional direct payment key (without this, direct form donations are recorded as pledges)
PAYSTACK_SECRET_KEY=
